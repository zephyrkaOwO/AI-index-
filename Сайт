    allTags.forEach(tag => {
        const btn = document.createElement('button');
        btn.className = 'tag-btn';
        btn.textContent = tag;
        btn.dataset.tag = tag;
        btn.onclick = () => selectTag(tag);
        dropdown.appendChild(btn);
    });
}

function selectTag(tag) {
    activeTag = tag;
    updateActiveFilter();
    updateTagsHighlight();
    render();
    if (tag !== null) {
        dropdownOpen = false;
        updateDropdownState();
    }
}

function updateActiveFilter() {
    const filterEl = document.getElementById('activeFilter');
    const textEl = document.getElementById('activeFilterText');
    const clearEl = document.getElementById('clearFilter');
    
    if (activeTag === null) {
        textEl.textContent = 'Все теги';
        clearEl.style.display = 'none';
    } else {
        textEl.textContent = activeTag;
        clearEl.style.display = 'inline';
    }
}

function updateTagsHighlight() {
    document.querySelectorAll('#tagsDropdown .tag-btn').forEach(btn => {
        const btnTag = btn.dataset.tag;
        const isActive = (activeTag === null && btnTag === '') || btnTag === activeTag;
        btn.classList.toggle('active', isActive);
    });
}

function updateDropdownState() {
    const dropdown = document.getElementById('tagsDropdown');
    const toggleBtn = document.getElementById('tagsToggle');
    
    dropdown.classList.toggle('open', dropdownOpen);
    toggleBtn.classList.toggle('open', dropdownOpen);
}

function toggleDropdown() {
    dropdownOpen = !dropdownOpen;
    updateDropdownState();
}

function clearFilter() {
    activeTag = null;
    updateActiveFilter();
    updateTagsHighlight();
    render();
}

function render() {
    const query = document.getElementById('search').value.toLowerCase();
    const sortBy = document.getElementById('sort').value;
    
    let filtered = tools.filter(t => {
        const matchSearch = !query || 
            t.name.toLowerCase().includes(query) || 
            t.desc.toLowerCase().includes(query) ||
            t.tags.some(tag => tag.toLowerCase().includes(query));
        const matchTag = !activeTag || t.tags.includes(activeTag);
        return matchSearch && matchTag;
    });
    
    filtered.sort((a, b) => {
        if (sortBy === 'name') return a.name.localeCompare(b.name, 'ru');
        if (sortBy === 'name-desc') return b.name.localeCompare(a.name, 'ru');
        if (sortBy === 'date') return new Date(b.date) - new Date(a.date);
        if (sortBy === 'date-old') return new Date(a.date) - new Date(b.date);
    });
    
    const grid = document.getElementById('grid');
    document.getElementById('counter').textContent = `Найдено: ${filtered.length} из ${tools.length}`;
    
    if (filtered.length === 0) {
        grid.innerHTML = '<div class="empty-state">😕 Ничего не найдено. Попробуйте другой запрос.</div>';
        return;
    }
    
    grid.innerHTML = filtered.map(t => `
        <div class="card" onclick="window.open('${t.url}', '_blank')">
            <div class="card-header">
                <div class="card-icon">${t.icon || '🤖'}</div>
                <div class="card-title">${t.name}</div>
            </div>
            <div class="card-desc">${t.desc}</div>
            <div class="card-tags">
                ${t.tags.map(tag => `<span class="card-tag">${tag}</span>`).join('')}
            </div>
            <a class="card-link" href="${t.url}" target="_blank" onclick="event.stopPropagation()">
                Перейти →
            </a>
        </div>
    `).join('');
}

document.getElementById('search').addEventListener('input', render);
document.getElementById('sort').addEventListener('change', render);
document.getElementById('tagsToggle').addEventListener('click', toggleDropdown);
document.getElementById('activeFilter').addEventListener('click', (e) => {
    if (e.target.id === 'clearFilter') {
        e.stopPropagation();
        clearFilter();
    }
});

initTags();
updateActiveFilter();
render();
</script>
</body>
</html>
