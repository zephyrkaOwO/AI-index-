<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Каталог ИИ-инструментов</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        :root {
            --bg: #0f0f14;
            --card-bg: #1a1a24;
            --card-hover: #24243a;
            --text: #e8e8f0;
            --text-dim: #8888a0;
            --accent: #7c5cff;
            --accent-hover: #9579ff;
            --border: #2a2a3e;
            --tag-bg: #2a2a3e;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            min-height: 100vh;
        }
        
        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
        
        header {
            text-align: center;
            padding: 40px 20px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 30px;
        }
        
        header h1 {
            font-size: 2.5rem;
            background: linear-gradient(135deg, var(--accent), #ff5c9c);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
        }
        
        header p { color: var(--text-dim); }
        
        .controls {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 30px;
            align-items: center;
        }
        
        .search-box {
            flex: 1;
            min-width: 250px;
            position: relative;
        }
        
        .search-box input {
            width: 100%;
            padding: 12px 16px 12px 42px;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text);
            font-size: 1rem;
            transition: border-color 0.2s;
        }
        
        .search-box input:focus {
            outline: none;
            border-color: var(--accent);
        }
        
        .search-box::before {
            content: "🔍";
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            opacity: 0.6;
        }
        
        .sort-select {
            padding: 12px 16px;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text);
            font-size: 1rem;
            cursor: pointer;
        }
        
        .tags-bar {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 25px;
            min-height: 40px;
        }
        
        .active-filter {
            padding: 8px 16px;
            background: var(--accent);
            color: white;
            border-radius: 20px;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: background 0.2s;
        }
        
        .active-filter:hover {
            background: var(--accent-hover);
        }
        
        .active-filter .clear-x {
            font-size: 1rem;
            opacity: 0.7;
            padding: 0 2px;
        }
        
        .active-filter .clear-x:hover {
            opacity: 1;
        }
        
        .tags-toggle-btn {
            padding: 8px 16px;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 20px;
            color: var(--text-dim);
            cursor: pointer;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
            margin-left: auto;
        }
        
        .tags-toggle-btn:hover {
            color: var(--text);
            border-color: var(--accent);
        }
        
        .tags-toggle-btn .arrow {
            transition: transform 0.3s;
            display: inline-block;
            font-size: 0.7rem;
        }
        
        .tags-toggle-btn.open .arrow {
            transform: rotate(180deg);
        }
        
        .tags-dropdown {
            display: none;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 25px;
            padding: 16px;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 14px;
            animation: fadeIn 0.2s ease;
        }
        
        .tags-dropdown.open {
            display: flex;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-5px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .tag-btn {
            padding: 6px 14px;
            background: var(--tag-bg);
            border: 1px solid var(--border);
            border-radius: 20px;
            color: var(--text-dim);
            cursor: pointer;
            font-size: 0.9rem;
            transition: all 0.2s;
            white-space: nowrap;
        }
        
        .tag-btn:hover { color: var(--text); border-color: var(--accent); }
        
        .tag-btn.active {
            background: var(--accent);
            color: white;
            border-color: var(--accent);
        }
        
        .tag-btn.all-tag {
            background: transparent;
            border: 1px solid var(--accent);
            color: var(--accent);
        }
        
        .tag-btn.all-tag.active {
            background: var(--accent);
            color: white;
        }
        
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
        }
        
        .card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 20px;
            transition: all 0.25s;
            cursor: pointer;
            display: flex;
            flex-direction: column;
        }
        
        .card:hover {
            background: var(--card-hover);
            transform: translateY(-3px);
            border-color: var(--accent);
        }
        
        .card-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }
        
        .card-icon {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            background: linear-gradient(135deg, var(--accent), #ff5c9c);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            flex-shrink: 0;
        }
        
        .card-title {
            font-size: 1.15rem;
            font-weight: 600;
        }
        
        .card-desc {
            color: var(--text-dim);
            font-size: 0.95rem;
            margin-bottom: 15px;
            flex-grow: 1;
        }
        
        .card-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 12px;
        }
        
        .card-tag {
            font-size: 0.75rem;
            padding: 3px 10px;
            background: var(--tag-bg);
            border-radius: 12px;
            color: var(--text-dim);
        }
        
        .card-link {
            color: var(--accent);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
        }
        
        .card-link:hover { color: var(--accent-hover); }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: var(--text-dim);
            grid-column: 1 / -1;
        }
        
        .counter {
            color: var(--text-dim);
            font-size: 0.9rem;
            margin-bottom: 15px;
        }
    </style>
</head>
